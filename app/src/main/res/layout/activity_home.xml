<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="view"
            type="android.view.View" />

        <variable
            name="title"
            type="String" />

        <variable
            name="onClick"
            type="android.view.View.OnClickListener" />

        <import type="android.text.TextUtils" />
    </data>

    <com.appversal.appstorys.ui.xml.OverlayLayoutView
        android:id="@+id/root_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#f1f2f4"
        app:pipBottomPadding="70dp"
        app:topPadding="70dp">

        <RelativeLayout
            android:id="@+id/rel_main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true">

            <LinearLayout
                android:id="@+id/content_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_above="@+id/bottom_navigation"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/home_one_image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="App Logo"
                    android:scaleType="fitXY"
                    android:src="@drawable/home_one" />

                <com.appversal.appstorys.ui.xml.WidgetView
                    android:id="@+id/tooltip_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <com.appversal.appstorys.ui.xml.WidgetView
                    android:id="@+id/tooltip_home_prem_test"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:placeholder="@drawable/ic_launcher_foreground"
                    app:position="widget_one" />

                <com.appversal.appstorys.ui.xml.StoriesView
                    android:id="@+id/stories_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:id="@+id/app_logo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="App Logo"
                    android:scaleType="fitXY"
                    android:src="@drawable/home_two" />

                <Button
                    android:id="@+id/open_bottom_sheet"
                    android:layout_width="187dp"
                    android:layout_height="59dp"
                    android:text="Open Bottom Sheet" />

                <Button
                    android:id="@+id/open_more_screen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open More Screen" />

                <!-- Replicates the client's navigation: pushes a fragment
                     ON TOP of this one with add() + addToBackStack() -->
                <Button
                    android:id="@+id/push_next_fragment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Push Next Fragment (repro)" />

            </LinearLayout>

            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottom_navigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:background="?android:attr/windowBackground"
                app:menu="@menu/bottom_nav_menu" />

        </RelativeLayout>

    </com.appversal.appstorys.ui.xml.OverlayLayoutView>

</layout>